{
  "manifest_version": 2,
  "id": "nxtsl.private-companion",
  "version": "1.3.0",
  "name": "我会一直陪着你",
  "description": "由 astrbot_plugin_private_companion 移植到 MaiBot 的持续型私人陪伴核心，提供专属上下文、连续记忆、生活状态和主动关怀。",
  "author": {
    "name": "nxtsl / menglimi",
    "url": "https://github.com/menglimi/astrbot_plugin_private_companion"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/NXTSL/maibot-private-companion",
    "homepage": "https://github.com/NXTSL/maibot-private-companion",
    "documentation": "https://github.com/NXTSL/maibot-private-companion",
    "issues": "https://github.com/NXTSL/maibot-private-companion/issues"
  },
  "host_application": {"min_version": "1.2.0", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.0.0", "max_version": "2.99.99"},
  "dependencies": [],
  "capabilities": [
    "llm.generate",
    "send.text",
    "send.hybrid",
    "chat.get_private_streams",
    "chat.get_group_streams",
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id",
    "maisaka.proactive.trigger"
  ],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
